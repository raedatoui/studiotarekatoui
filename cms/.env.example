# Firestore Enterprise with MongoDB compatibility (copy the real URL from Secret Manager).
DATABASE_URL=
PAYLOAD_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3001
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated exact Google email addresses. Empty means nobody can sign in.
CMS_ALLOWED_EMAILS=
# Website receiving unsaved editor changes through Live Preview.
WEBSITE_PREVIEW_URL=http://localhost:3000
# Upload destination and public URL for the same object prefix.
MEDIA_BUCKET=gs://your-media-bucket
MEDIA_PREFIX=your-site
MEDIA_BASE_URL=https://cdn.example.com/your-site
