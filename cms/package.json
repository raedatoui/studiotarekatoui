{
    "name": "@tarek/cms",
    "version": "1.0.0",
    "description": "Payload CMS for Studio Tarek Atoui on Firebase App Hosting and Firestore",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --hostname localhost --port 3001",
        "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
        "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
        "lint": "biome lint .",
        "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
        "start": "cross-env NODE_OPTIONS=--no-deprecation next start --hostname localhost --port 3001",
        "format": "biome format --write .",
        "check": "biome check .",
        "typecheck": "tsc --noEmit",
        "deploy": "bash scripts/deploy.sh"
    },
    "dependencies": {
        "@google-cloud/storage": "^8.2.0",
        "@next/env": "catalog:",
        "@payloadcms/db-mongodb": "catalog:",
        "@payloadcms/next": "catalog:",
        "@payloadcms/ui": "catalog:",
        "@tarek/content": "workspace:*",
        "cross-env": "^7.0.3",
        "graphql": "^16.8.1",
        "next": "16.3.5",
        "next-auth": "5.0.0-beta.32",
        "payload": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "sharp": "0.35.5"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=22.13 <23"
    },
    "private": true
}
