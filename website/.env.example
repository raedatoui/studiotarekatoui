# Copy to .env. These settings contain no credentials; gcloud uses your signed-in account.
MEDIA_BUCKET=gs://typedef
MEDIA_PREFIX=tarekatoui.com
NEXT_PUBLIC_MEDIA_BASE_URL=https://cdn.typedefinc.com/tarekatoui.com
# Exact trusted CMS origin for preview messages (no trailing slash).
NEXT_PUBLIC_CMS_ORIGIN=http://localhost:3001
# Use staging for noindex builds; production canonicals always use tarekatoui.com.
NEXT_PUBLIC_SITE_ENV=production
