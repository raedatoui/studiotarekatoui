# Copy to .env and configure your own public media and deployment URLs.
# Uploads use your signed-in gcloud account; these settings are not credentials.
MEDIA_BUCKET=gs://your-media-bucket
MEDIA_PREFIX=your-site
NEXT_PUBLIC_MEDIA_BASE_URL=https://cdn.example.com/your-site
NEXT_PUBLIC_SITE_URL=https://example.com
# Exact trusted CMS origin (no trailing slash).
NEXT_PUBLIC_CMS_ORIGIN=http://localhost:3001
# Use staging for noindex builds; canonicals always use NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_ENV=production
