# Deployment settings only. Copy to .env and configure your own resources.
# Credentials belong in cms/.env locally and Secret Manager when hosted.
FIREBASE_PROJECT_ID=
FIREBASE_HOSTING_SITE_PROD=
FIREBASE_HOSTING_SITE_STAGING=
FIREBASE_APPHOSTING_BACKEND_ID=
CMS_AUTH_URL=https://cms.example.com
CMS_WEBSITE_PREVIEW_URL=https://staging.example.com
CMS_MEDIA_BUCKET=gs://your-media-bucket
CMS_MEDIA_PREFIX=your-site
CMS_MEDIA_BASE_URL=https://cdn.example.com/your-site
# Secret Manager references, e.g. your-secret-name@1. Never put secret values here.
CMS_DATABASE_URL_REF=
CMS_PAYLOAD_SECRET_REF=
CMS_AUTH_SECRET_REF=
CMS_AUTH_GOOGLE_ID_REF=
CMS_AUTH_GOOGLE_SECRET_REF=
CMS_ALLOWED_EMAILS_REF=
