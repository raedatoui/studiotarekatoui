{
    "name": "studiotarekatoui",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.27.1",
    "engines": { "node": ">=22.13 <23", "pnpm": "11.27.1" },
    "scripts": {
        "dev": "pnpm --parallel --filter @tarek/website --filter @tarek/cms run dev",
        "dev:web": "pnpm --filter @tarek/website run dev",
        "dev:cms": "pnpm --filter @tarek/cms run dev",
        "build:web": "pnpm --filter @tarek/website run build",
        "build:cms": "pnpm --filter @tarek/cms run build",
        "deploy:cms": "pnpm --filter @tarek/cms run deploy",
        "content:export": "tsx cms/scripts/export-content.ts",
        "content:validate": "tsx packages/content/src/validate.ts",
        "content:import": "tsx cms/scripts/import-content.ts",
        "media:upload": "pnpm --filter @tarek/website run media:upload",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check .",
        "typecheck": "pnpm --recursive run typecheck"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/node": "catalog:",
        "tsx": "4.21.0",
        "typescript": "catalog:"
    }
}
